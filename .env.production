# Firecrawl Production Environment Configuration
# Copy this file to .env and update the values for your deployment

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# API Configuration
FIRECRAWL_API_KEY=7877e105e5f7b9ec3edf4a8eec5059ab9914efef1b30fe232f59ff31cb8e6fcf
BULL_AUTH_KEY=firecrawl-admin-2024

# Port Configuration
FIRECRAWL_PORT=3002
OLLAMA_PORT=11434
NGINX_PORT=80
NGINX_SSL_PORT=443

# =============================================================================
# AI/LLM CONFIGURATION - GEMINI 2.5 FLASH + OLLAMA EMBEDDINGS
# =============================================================================

# Gemini 2.5 Flash for main processing (300k requests/month limit)
GEMINI_API_KEY=AIzaSyAJWyUi0s9DHtRorkuDVnpoxDXqDGTqNdw
MODEL_NAME=gemini-2.5-flash
LLM_API_KEY=AIzaSyAJWyUi0s9DHtRorkuDVnpoxDXqDGTqNdw

# Ollama for local embeddings (cost-effective)
OLLAMA_BASE_URL=http://ollama:11434
MODEL_EMBEDDING_NAME=nomic-embed-text
OLLAMA_MODEL=nomic-embed-text

# =============================================================================
# WEBSHARE PROXY CONFIGURATION - 100 PROXIES FOR 300K REQUESTS/MONTH
# =============================================================================

# Update these with your Webshare.io credentials
WEBSHARE_USERNAME=your-webshare-username-here
WEBSHARE_PASSWORD=your-webshare-password-here

# Proxy settings for high-volume scraping
PROXY_SERVER=p.webshare.io:80
USE_PROXY=true
ROTATING_PROXY=true
PROXY_ROTATION_COUNT=100

# =============================================================================
# PERFORMANCE CONFIGURATION FOR 300K REQUESTS/MONTH
# =============================================================================

# Worker Configuration (optimized for high throughput)
NUM_WORKERS_PER_QUEUE=8
SCRAPE_RATE_LIMIT_CRAWL_PARALLEL=4
SCRAPE_RATE_LIMIT_CRAWL_PARALLEL_SCALE=20

# Rate Limiting
RATE_LIMIT_TEST_MODE=false

# =============================================================================
# SECURITY & MONITORING (OPTIONAL)
# =============================================================================

# Leave empty for self-hosted deployment
SLACK_WEBHOOK_URL=
POSTHOG_API_KEY=
POSTHOG_HOST=
SENTRY_DSN=
LOGTAIL_KEY=

# Database (Optional - uses memory if not configured)
USE_DB_AUTHENTICATION=false
SUPABASE_ANON_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_TOKEN=

# Search APIs (Optional)
SERPER_API_KEY=
SEARCHAPI_API_KEY=

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379/1

# Service URLs
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000
FIRE_ENGINE_BETA_URL=http://fire-engine:8080

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================

NODE_ENV=production
HOST=0.0.0.0
LOGGING_LEVEL=info
BLOCK_MEDIA=true

# =============================================================================
# CONFIGURATION NOTES
# =============================================================================

# 1. Gemini 2.5 Flash Configuration:
#    - Optimized for speed and cost-effectiveness
#    - 300k requests/month should handle your target volume
#    - Replace GEMINI_API_KEY with your actual key

# 2. Ollama Embeddings:
#    - Uses nomic-embed-text model for local embedding generation
#    - Significantly reduces costs compared to cloud embedding APIs
#    - Model will be auto-downloaded on first startup

# 3. Webshare Proxy Setup:
#    - 100 rotating proxies for high-volume scraping
#    - Update WEBSHARE_USERNAME and WEBSHARE_PASSWORD
#    - Supports 300k+ requests per month with rotation

# 4. Performance Tuning:
#    - 8 workers per queue for high concurrency
#    - Optimized rate limiting for sustained throughput
#    - Can scale horizontally by adding more worker containers

# 5. Security:
#    - All optional monitoring services can be left empty
#    - FIRECRAWL_API_KEY should be regenerated for production
#    - Consider setting up proper SSL certificates